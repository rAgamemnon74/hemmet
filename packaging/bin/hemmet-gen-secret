#!/usr/bin/env bash
# hemmet-gen-secret — regenererar AUTH_SECRET i /etc/hemmet/env.
# OBSERVERA: invaliderar alla aktiva sessioner (användare får logga in igen).

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "❌ Måste köras som root (eller via sudo)" >&2
    exit 1
fi

ENV_FILE=/etc/hemmet/env
if [ ! -e "$ENV_FILE" ]; then
    echo "❌ $ENV_FILE saknas. Kör hemmet-setup först." >&2
    exit 1
fi

NEW_SECRET=$(openssl rand -base64 32)
if grep -qE "^AUTH_SECRET=" "$ENV_FILE"; then
    sed -i "s|^AUTH_SECRET=.*|AUTH_SECRET=${NEW_SECRET}|" "$ENV_FILE"
else
    echo "AUTH_SECRET=${NEW_SECRET}" >> "$ENV_FILE"
fi

chmod 0640 "$ENV_FILE"
chown root:hemmet "$ENV_FILE"

echo "✓ AUTH_SECRET regenererat."
echo "Startar om hemmet.service..."
systemctl restart hemmet.service
echo "✓ Klart. Befintliga sessioner invaliderade."
