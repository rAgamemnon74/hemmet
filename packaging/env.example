# Hemmet — produktionskonfiguration
# Läses av systemd via EnvironmentFile=/etc/hemmet/env
# Rättigheter: chmod 0640, ägs av root:hemmet

# ── Databas ────────────────────────────────────────────────
# Native PostgreSQL på brunkan (installerad via apt)
# Skapa användare + databas:
#   sudo -u postgres createuser --pwprompt hemmet
#   sudo -u postgres createdb --owner=hemmet hemmet
DATABASE_URL=postgresql://hemmet:CHANGE_ME@localhost:5432/hemmet

# ── NextAuth ───────────────────────────────────────────────
# Generera med: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTE_STRING
AUTH_TRUST_HOST=true
# Ersätt med föreningens domän i produktion
NEXTAUTH_URL=http://brunkan.local:3000

# ── Next.js ────────────────────────────────────────────────
NODE_ENV=production
# Servern lyssnar på PORT (0.0.0.0 default i standalone)
PORT=3000
HOSTNAME=0.0.0.0

# ── Uppladdade dokument ────────────────────────────────────
# Måste matcha filsystem-ägare (skapas automatiskt av postinst)
UPLOAD_DIR=/var/lib/hemmet/uploads
